#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "json"
require_relative "../lib/giraffe/harness"
require_relative "../lib/giraffe/tickets"
require_relative "../lib/giraffe/graph_view"

begin
  command = ARGV.shift
  ARGV.unshift(command) if %w[-h --help].include?(command)
  options = {}
  parser = OptionParser.new do |opts|
    opts.banner = "Usage: giraffe start TICKET --config FILE [--ticket-file FILE] [--dry-run]\n       giraffe status|graph|events|harness|resume|sync|cancel RUN.jsonl\n       giraffe answer RUN.jsonl QUESTION_ID ANSWER\n       giraffe restore RUN_ID --context REF --ticket ID --destination DIR"
    opts.on("--after SEQ", Integer) { |value| options[:after] = value }
    opts.on("--config FILE") { |value| options[:config] = value }
    opts.on("--ticket-file FILE") { |value| options[:ticket_file] = value }
    opts.on("--dry-run") { options[:dry_run] = true }
    opts.on("--context REF") { |value| options[:context] = value }
    opts.on("--ticket ID") { |value| options[:ticket] = value }
    opts.on("--destination DIR") { |value| options[:destination] = value }
    opts.on("-h", "--help") { puts opts; exit }
  end
  parser.parse!(ARGV)
  output = case command
           when "start"
             config = Giraffe::Config.load(options[:config], overrides: options[:dry_run] ? {"dry_run" => true} : {})
             ticket = Giraffe::Tickets.load(identifier: ARGV.shift, file: options[:ticket_file])
             if config["dry_run"]
               {"status" => "dry_run", "ticket" => ticket["id"], "repo" => config["repo"], "base" => config["base"],
                "steps" => Giraffe::Harness::ORDER, "checks" => config["checks"]}
             else
               run = Giraffe::Run.start(config, ticket)
               Giraffe::Harness.new(run).run
               {"path" => run.path, "status" => run.state["status"], "questions" => run.state["questions"], "sync" => run.sync}
             end
           when "status", "resume", "harness", "answer", "cancel", "sync", "graph", "events"
             run = Giraffe::Run.load(File.expand_path(ARGV.shift || raise(Giraffe::Error, "run path is required")))
             case command
             when "resume", "harness" then Giraffe::Harness.new(run).run
             when "answer"
               run.answer(ARGV.shift, ARGV.join(" "))
               run.sync
             when "cancel"
               File.write(File.join(run.directory, "cancel.request"), "cancel\n", mode: "w", perm: 0o600)
               begin
                 run.lock { run.update(status: "cancelled", error: "Cancellation requested by the operator") }
               rescue Giraffe::Error => error
                 raise unless error.message.include?("active harness")
               end
             when "sync" then run.lock { run.sync }
             end
             if command == "graph"
               puts JSON.pretty_generate(Giraffe::GraphView.new(run).snapshot)
               exit
             elsif command == "events"
               puts JSON.pretty_generate(Giraffe::GraphView.new(run).events(after: options.fetch(:after, 0)))
               exit
             end
             sync_file = run.path.sub(/\.jsonl\z/, ".sync.json")
             {"path" => run.path, "status" => run.state["status"], "questions" => run.state["questions"], "error" => run.state["error"],
              "cancel_requested" => File.exist?(File.join(run.directory, "cancel.request")),
              "graph" => Giraffe::GraphView.new(run).snapshot,
              "sync" => File.exist?(sync_file) ? JSON.parse(File.read(sync_file)) : {"synced" => false}}
           when "restore"
             id = ARGV.shift || raise(Giraffe::Error, "run ID is required")
             raise Giraffe::Error, "invalid run ID" unless id.match?(PrGraph::EventLog::UUID)
             %i[context ticket destination].each { |key| raise Giraffe::Error, "--#{key} is required" unless options[key] }
             destination = File.expand_path(options[:destination])
             raise Giraffe::Error, "restore destination must be empty" if File.exist?(destination) && Dir.children(destination).any?
             remote = PrGraph::Store.new(context: options[:context], run_id: id, ticket: options[:ticket])
             records = remote.read_records(PrGraph::Shapes::HARNESS)
             state = records.max_by { |row| row.fetch("revision") } || raise(Giraffe::Error, "no fully synced checkpoint")
             raise Giraffe::Error, "checkpoint identity mismatch" unless state["run_id"] == id && state.dig("config", "context") == options[:context]
             FileUtils.mkdir_p(destination, mode: 0o700)
             path = File.join(destination, "run.jsonl")
             remote.hydrate(path)
             File.write(path.sub(/\.jsonl\z/, ".state.jsonl"), JSON.generate(state) + "\n", mode: "w", perm: 0o600)
             File.write(path.sub(/\.jsonl\z/, ".harness.json"), JSON.generate(state), mode: "w", perm: 0o600)
             {"path" => path, "status" => "restored", "revision" => state["revision"], "note" => "Repository and worktree paths must still exist; cross-host relocation is not implemented."}
           else
             puts parser
             exit(command ? 1 : 0)
           end
  puts JSON.pretty_generate(output)
rescue StandardError => error
  warn JSON.generate("error" => error.message)
  exit 1
end
